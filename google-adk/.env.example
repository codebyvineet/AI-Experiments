# MongoDB Configuration
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=adk_demo

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_DB=0

# JWT Configuration (REQUIRED — generate with: python -c 'import secrets; print(secrets.token_urlsafe(32))')
JWT_SECRET_KEY=your-generated-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Generative AI / Vertex AI Configuration
# Option A: Google AI Studio API key (simplest)
GOOGLE_API_KEY=your-google-api-key

# Option B: Vertex AI (Service Account)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json

# Gemini model to use
GEMINI_MODEL=gemini-2.0-flash

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# Standalone MCP Server URL (container name in Docker)
MCP_SERVER_URL=http://mcp-server:8001

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
