# MongoDB Configuration
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DATABASE=mcp_demo

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_DB=0

# JWT Configuration (REQUIRED - generate a secure key using: python -c 'import secrets; print(secrets.token_urlsafe(32))')
JWT_SECRET_KEY=your-generated-secret-key-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Google Vertex AI Configuration (Gemini 2.5)
# Set your Google Cloud project ID
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# Set the location for Vertex AI (default: us-central1)
GOOGLE_CLOUD_LOCATION=us-central1
# Path to your Google Service Account JSON file
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account.json
# Vertex AI model to use (default: gemini-2.5-pro)
VERTEXAI_MODEL=gemini-2.5-pro

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# MCP Server Configuration
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8001
